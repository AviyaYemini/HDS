# Copy to .env and replace placeholders. Never commit real secrets.
POSTGRES_DB=hds
POSTGRES_USER=hds
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://hds:change-me@localhost:5432/hds
# Integration tests only. Unset, each run creates its own database and drops it, so several runs can
# go at once. Set it to use and keep one named database; the name must end in "_test".
# TEST_DATABASE_URL=postgresql+asyncpg://hds:change-me@localhost:5432/hds_test
# Required and stated explicitly. "development" and "test" may use a weak secret; any other value
# (production, staging, ...) needs a strong secret and a real mail backend.
ENVIRONMENT=development
# Left empty on purpose: the API and docker compose both refuse to start until you set one.
# generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# Optional. Uncomment to change; the defaults are in apps/api/README.md (Configuration).
# JWT_ALGORITHM=HS256
# MAIL_BACKEND=outbox
# MAIL_OUTBOX_PATH=apps/api/.dev-mail/outbox.jsonl
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_REUSE_GRACE_SECONDS=10
# THROTTLE_SECRET_KEY=
# LOGIN_RATE_LIMIT_PER_NETWORK=30
# LOGIN_THROTTLE_RETENTION_HOURS=24
# RESET_REQUEST_LIMIT_PER_ADDRESS=5
# RESET_REQUEST_LIMIT_PER_NETWORK=30
# RESET_JOB_CONCURRENCY=2
# RESET_JOB_QUEUE_LIMIT=100
# RESET_JOB_TIMEOUT_SECONDS=30
# TRUSTED_PROXY_COUNT=0
# HASH_CONCURRENCY=2
# HASH_QUEUE_LIMIT=8
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
