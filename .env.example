# Copy to .env and replace placeholders. Never commit real secrets.
POSTGRES_DB=hds
POSTGRES_USER=hds
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://hds:change-me@localhost:5432/hds
# Integration tests only; the database name must end in "_test" (created automatically).
TEST_DATABASE_URL=postgresql+asyncpg://hds:change-me@localhost:5432/hds_test
# Required and stated explicitly. "development" and "test" may use a weak secret; any other value
# (production, staging, ...) needs a strong secret and a real mail backend.
ENVIRONMENT=development
# Left empty on purpose: the API and docker compose both refuse to start until you set one.
# generate one with: openssl rand -hex 32
JWT_SECRET_KEY=
