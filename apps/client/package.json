{
  "name": "hds-client",
  "version": "0.1.0",
  "private": true,
  "description": "HDS app for iOS, Android and the web (Expo, React Native and React Native Web).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "e2e": "EXPO_PUBLIC_API_URL=http://localhost:8100 expo export --platform web --output-dir dist && playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "@hds/api-client": "workspace:*",
    "expo": "58.0.17",
    "expo-constants": "58.0.13",
    "expo-linking": "58.0.14",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.25",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "i18next": "26.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-plugin-i18next": "6.1.5",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
