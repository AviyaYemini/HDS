# The build context is the repository root (infra/docker-compose.yml). Dockerfile.api copies only
# named paths under apps/api, so nothing below reaches the image; this keeps secrets, the database
# files and caches out of the context sent to the builder.
.git/
.env
.env.*
!.env.example
infra/volumes/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.dev-mail/
**/node_modules/
*.log
.DS_Store
# The client's own build and test outputs: the web image builds its export afresh.
apps/client/dist/
apps/client/coverage/
apps/client/playwright-report/
apps/client/test-results/
apps/client/.jest-cache/
