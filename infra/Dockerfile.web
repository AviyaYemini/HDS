# The web image: the Expo web export, served by an unprivileged nginx (specs/006-deploy-operations
# research R2). Bases pinned by tag and digest, as listed in infra/VERSIONS.md. The build context is
# the repository root, as for infra/Dockerfile.api.
#
# EXPO_PUBLIC_API_URL is baked into the bundle at build time. The cluster image keeps it empty, so
# the browser calls the API on its own origin and the ingress routes /api, /auth and /me to it; the
# local compose build passes http://localhost:8000, because there the API is on another port.
FROM node:22.23.4-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS build

WORKDIR /repo
# pnpm at exactly the version package.json's packageManager names.
RUN corepack enable

# Dependencies first, so a source change does not reinstall them.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/client/package.json apps/client/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN pnpm install --frozen-lockfile --filter hds-client...

COPY apps/client apps/client
COPY packages/api-client packages/api-client

ARG EXPO_PUBLIC_API_URL=""
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
RUN pnpm --filter hds-client export:web

FROM nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03

COPY infra/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/client/dist /usr/share/nginx/html

# The commit this image was built from (FR-010), declared last so a new version reuses every layer.
ARG HDS_VERSION=dev
LABEL org.opencontainers.image.version="${HDS_VERSION}" \
      org.opencontainers.image.source="https://github.com/AviyaYemini/HDS"

EXPOSE 8080
